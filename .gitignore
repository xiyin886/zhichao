# ============================================================
# 知潮 · .gitignore
# 原则：源码、配置、站点运行所需素材入库；
#       备份、历史归档、运行缓存、日志、临时产物与大体积
#       原始媒体不入库，由本地/服务器单独维护与部署。
# ============================================================

# ---------- 1. 本地运行记忆 / 工作数据（私有，不随仓库分发） ----------
.data/
.workbuddy/

# ---------- 1b. 本机密钥（绝不入库） ----------
.env
.env.local

# ---------- 2. 备份与历史归档（本地同步备份、旧版素材、Live2D 工程） ----------
backups/
live2d/
.sync-backup-*/
cloud/_archive/
cloud/assets/_archive/

# ---------- 3. 大体积媒体：形象页视频等单独 scp 部署，不入库 ----------
cloud/assets/art/

# 3a. 热点数据：由云电脑「知潮每日策展」定时任务产出并 scp 直推服务器，绝不入库
cloud/data/current.json
cloud/data/current.json.gz
cloud/data/changelog.json
cloud/data/changelog.json.gz

# 3b. 上传立绘占位目录 self-upload：只保留 README，图片实际在服务器 /data/art/，不入库
cloud/assets/self-upload/*
!cloud/assets/self-upload/README.md

# ---------- 4. Python 缓存 ----------
__pycache__/
*.pyc
*.pyo

# ---------- 5. 日志与运行临时产物 ----------
*.log
dev/.preview-memory.json
*.tmp
*.bak
*.cache

# ---------- 6. 依赖与构建产物（预留，当前仓库为纯静态原生项目） ----------
node_modules/
dist/
build/

# ---------- 7. 系统 / 编辑器杂项 ----------
.DS_Store
Thumbs.db
desktop.ini
*~
